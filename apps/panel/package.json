{
  "name": "@seylo/panel",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "description": "The panel: op API, agent hub, live updates, jobs and SQLite; serves the web app.",
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/main.ts",
    "start": "bun src/main.ts",
    "build": "bun build src/main.ts --target bun --outdir dist --sourcemap=linked && bun build scripts/rotate-master-key.ts --target bun --outdir dist",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts && drizzle-kit generate --config drizzle.metrics.config.ts",
    "create-owner": "bun scripts/create-owner.ts",
    "rotate-master-key": "bun scripts/rotate-master-key.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.137.0",
    "@bufbuild/protobuf": "2.17.0",
    "@dicebear/collection": "9.4.3",
    "@dicebear/core": "9.4.3",
    "@jitl/quickjs-wasmfile-release-sync": "0.32.0",
    "@seylo/brand": "workspace:*",
    "@seylo/env-analyzer": "workspace:*",
    "@seylo/ops": "workspace:*",
    "@seylo/proto": "workspace:*",
    "@simplewebauthn/server": "14.0.3",
    "@sinclair/typebox": "0.34.52",
    "croner": "10.0.1",
    "drizzle-orm": "0.45.4",
    "elysia": "1.4.31",
    "nanoid": "6.0.2",
    "nodemailer": "10.1.7",
    "pino": "10.4.0",
    "quickjs-emscripten-core": "0.32.0",
    "ssh2": "1.17.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/ssh2": "1.15.5",
    "drizzle-kit": "0.31.11"
  }
}
